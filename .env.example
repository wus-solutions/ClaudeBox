# Tailnet-Hostname des Containers. Lokal und produktiv unterschiedlich waehlen,
# sonst kollidiert der Node-State.
TS_HOSTNAME=claude-box

# Auth-Key aus der Tailscale-Admin-Konsole: single-use, pre-approved,
# mit Tag tag:claude-box. NICHT ephemer - ephemere Nodes verschwinden beim
# Offline-Gehen und entwerten den State in /var/lib/tailscale.
# Nur fuer die erste Anmeldung noetig. Danach leeren: die Identitaet liegt im
# Volume tailscale-state, und der Key stuende sonst auch im claude-Container.
TS_AUTHKEY=

# Buzz-Relay, ausgehende WebSocket-Verbindung.
BUZZ_RELAY_URL=

# Nostr-Secret des Agenten (hex oder nsec). Erzeugt mit:
#   buzz-admin generate-key
# Fuer lokale Tests ein eigenes Keypair verwenden, nicht das produktive.
BUZZ_PRIVATE_KEY=

# Eigener Pubkey (64-stellig hex). Gate fuer --respond-to owner-only.
BUZZ_ACP_AGENT_OWNER=

# Eigener PRIVATER Schluessel (nsec oder 64 Hex). Nur fuer die Werkzeuge unter
# tools/ auf dem HOST - er wird nie in den Container gereicht. Buzz Desktop
# zeigt ihn unter Settings -> Private key -> Reveal.
BUZZ_OWNER_KEY=

# Owner-Attestierung je Agent (NIP-OA), damit Buzz den Agenten als Agenten
# erkennt - sonst ist er ein gewoehnliches Konto: nicht im Agentenverzeichnis,
# und eine @-Mention zieht ihn nicht in einen Huddle. Ein Eintrag je Agent,
# kommagetrennt wie bei GITHUB_TOKENS:
#   BUZZ_AUTH_TAGS=agentname=<signatur>,zweiter=<signatur>
# Traegt tools/enroll-agent.py --write-env selbst ein.
BUZZ_AUTH_TAGS=

# --- Cron (optional) ---

# 1 = der Entrypoint legt je Agent /run/buzz/<name>.env an (0640 root:dev, im
# tmpfs), damit ein Cron-Job ueber buzz schreiben kann: cron startet Jobs mit
# leerer Umgebung und sieht die BUZZ_*-Variablen sonst nicht. Im Job laden mit
#   set -a; . /run/buzz/<agent>.env; set +a
#
# Leer lassen, wenn kein Cron-Job das braucht: mit dem Schalter liegt der
# Schluessel lesbar im Dateisystem des Containers.
CRON_SECRETS=

# --- GitHub (optional) ---

# Zuordnung Owner -> Fine-grained Token, kommagetrennt:
#   GITHUB_TOKENS=owner=token,owner=token
# Ein Fine-grained Token gilt immer nur fuer EINEN Resource Owner. Fuer Repos
# unter mehreren Ownern je einen Token erzeugen und hier zuordnen. Der Owner
# ist der erste Pfadteil der Repo-URL; Gross-/Kleinschreibung egal.
#
# Beim Bearbeiten eines Tokens in der GitHub-UI die Repo-Liste kontrollieren:
# der Edit-Dialog setzt "Repository access" auf "All repositories" zurueck,
# statt die Auswahl zu behalten. Der Agent laeuft mit bypassPermissions -
# was der Token darf, darf er ohne Rueckfrage.
GITHUB_TOKENS=

# Fallback fuer Owner ohne eigenen Eintrag. Kann leer bleiben.
GITHUB_TOKEN=

# Commit-Identitaet des Agenten.
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- SSH (optional) ---

# Public Keys fuer den Zugriff per SSH ueber das Tailnet, mehrere durch ';'
# getrennt. Leer = sshd bleibt aus, das Web-Terminal laeuft trotzdem.
# Danach: ssh dev@<TS_HOSTNAME>.<tailnet>.ts.net
SSH_AUTHORIZED_KEYS=
