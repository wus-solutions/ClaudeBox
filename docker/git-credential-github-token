#!/usr/bin/env bash
# Git-Credential-Helper fuer GitHub, mit Unterstuetzung fuer mehrere Owner.
#
# Fine-grained Tokens haben genau einen Resource Owner. Wer Repos unter
# mehreren Ownern braucht - etwa privat und Firma - braucht mehrere Tokens.
# Git unterscheidet Zugangsdaten normalerweise nur nach Protokoll und Host,
# und der ist hier immer github.com. Deshalb ist credential.useHttpPath
# aktiviert: git reicht dann den Pfad mit durch, und dieser Helper liest den
# Owner daraus ab.
#
#   GITHUB_TOKENS   Zuordnung, kommagetrennt:
#                     owner=token,owner=token
#                   Owner-Vergleich ist gross-/kleinschreibungsunabhaengig,
#                   "ExampleOrg" und "exampleorg" sind dasselbe.
#   GITHUB_TOKEN    Fallback fuer Owner ohne eigenen Eintrag.
#
# Eine einzelne Variable statt GITHUB_TOKEN_<OWNER>, weil Compose und die
# Coolify-UI jede Variable namentlich durchreichen muessen - ein weiterer
# Owner waere sonst eine Aenderung am Compose-File statt an der Konfiguration.
#
# Die Tokens werden nie auf die Platte geschrieben - sie existieren nur in der
# Prozessumgebung. Fehlt der passende, liefert der Helper nichts und git faellt
# auf sein normales Verhalten zurueck.
set -uo pipefail

[[ "${1:-}" == "get" ]] || exit 0

# git uebergibt die Anfrage als key=value-Zeilen auf stdin.
host=""
path=""
while IFS='=' read -r key value; do
  [[ -z "$key" ]] && break
  case "$key" in
    host) host="$value" ;;
    path) path="$value" ;;
  esac
done

[[ "$host" == "github.com" ]] || exit 0

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

token=""
if [[ -n "$path" && -n "${GITHUB_TOKENS:-}" ]]; then
  want=$(lower "${path%%/*}")
  # Kommagetrennte Paare durchgehen, erster Treffer gewinnt.
  IFS=',' read -ra pairs <<<"$GITHUB_TOKENS"
  for pair in "${pairs[@]}"; do
    pair="${pair#"${pair%%[![:space:]]*}"}"   # fuehrende Leerzeichen weg
    owner="${pair%%=*}"
    value="${pair#*=}"
    [[ "$owner" == "$pair" ]] && continue     # kein "=" enthalten, ueberspringen
    if [[ "$(lower "$owner")" == "$want" ]]; then
      token="$value"
      break
    fi
  done
fi

[[ -n "$token" ]] || token="${GITHUB_TOKEN:-}"
[[ -n "$token" ]] || exit 0

echo "username=x-access-token"
echo "password=$token"
